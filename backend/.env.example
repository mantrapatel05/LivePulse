# Set this in the deployment environment to protect the /metrics endpoint.
METRICS_TOKEN=replace-with-a-long-random-token

# Optional: set an OTLP HTTP endpoint to enable backend traces.
# Leave unset to disable tracing. Use 0..1; default sampling rate is 0.1.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATE=0.1

# Worker metrics are available only on the internal service network.
WORKER_METRICS_PORT=9464
WORKER_METRICS_HOST=127.0.0.1

# Public badge count, project cache, and per-IP rate limits.
# BADGE_COUNT_TTL_SECONDS=15
# BADGE_PROJECT_TTL_SECONDS=60
# BADGE_BRAND_FLOOR=3
# BADGE_RATE_LIMIT_PER_IP_PER_MIN=120
# BADGE_LANDING_RATE_LIMIT_PER_IP_PER_MIN=60

# AI Session Insights (OpenRouter-compatible chat completions API).
# Leave the key/model unset to keep the AI insight feature unavailable; the API still starts.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Choose a current provider model identifier; availability changes over time.
LLM_MODEL=
LLM_TIMEOUT_MS=15000
AI_INSIGHT_PER_USER_PER_MIN=10
AI_INSIGHT_PER_PROJECT_PER_MIN=30
AI_INSIGHT_DAILY_CALLS_PER_PROJECT=100
