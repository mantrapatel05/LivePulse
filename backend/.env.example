# Set this in the deployment environment to protect the /metrics endpoint.
METRICS_TOKEN=replace-with-a-long-random-token

# Optional: set an OTLP HTTP endpoint to enable backend traces.
# Leave unset to disable tracing. Use 0..1; default sampling rate is 0.1.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATE=0.1

# Worker metrics are available only on the internal service network.
WORKER_METRICS_PORT=9464
WORKER_METRICS_HOST=127.0.0.1
